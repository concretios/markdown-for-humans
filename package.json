{
  "name": "markdown-for-humans",
  "displayName": "Markdown Editor for Humans",
  "description": "WYSIWYG Markdown editor with AI review comments, visual tables, Mermaid and image resizing.",
  "version": "0.4.5",
  "publisher": "concretio",
  "author": {
    "name": "Abhinav",
    "email": "abhinav@concret.io"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/concretios/markdown-for-humans"
  },
  "bugs": {
    "url": "https://github.com/concretios/markdown-for-humans/issues"
  },
  "homepage": "https://github.com/concretios/markdown-for-humans#readme",
  "engines": {
    "vscode": "^1.98.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Markdown Editor for Humans currently requires a disk-backed workspace for document-adjacent images, exports, and Feedback drafts."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Trust is required because the extension reads, writes, renders, and exports workspace content."
    }
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "md",
    "editor",
    "markdown-editor",
    "wysiwyg",
    "viewer",
    "markdown-viewer",
    "reader",
    "preview",
    "markdown-preview",
    "table",
    "table-editor",
    "mermaid",
    "diagram",
    "katex",
    "math",
    "typora",
    "obsidian",
    "notion",
    "notion-like",
    "rich-text",
    "gfm",
    "readme",
    "documentation",
    "writing",
    "pdf",
    "docx",
    "image",
    "image-resizing",
    "ai"
  ],
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "markdownForHumans.codeKeyword",
        "description": "%color.codeKeyword.description%",
        "defaults": {
          "light": "#a31545",
          "dark": "#c586c0",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeString",
        "description": "%color.codeString.description%",
        "defaults": {
          "light": "#a31515",
          "dark": "#ce9178",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeValue",
        "description": "%color.codeValue.description%",
        "defaults": {
          "light": "#0451a5",
          "dark": "#b5cea8",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeFunction",
        "description": "%color.codeFunction.description%",
        "defaults": {
          "light": "#6f42c1",
          "dark": "#dcdcaa",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeType",
        "description": "%color.codeType.description%",
        "defaults": {
          "light": "#00695c",
          "dark": "#4ec9b0",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeComment",
        "description": "%color.codeComment.description%",
        "defaults": {
          "light": "#57606a",
          "dark": "#a3a3a3",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeAddition",
        "description": "%color.codeAddition.description%",
        "defaults": {
          "light": "#116329",
          "dark": "#7ee787",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeDeletion",
        "description": "%color.codeDeletion.description%",
        "defaults": {
          "light": "#a40e26",
          "dark": "#ffa198",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "markdownForHumans.editor",
        "displayName": "%customEditor.editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.md",
            "scheme": "untitled"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "untitled"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownForHumans.openFile",
        "title": "%command.openFile.title%"
      },
      {
        "command": "markdownForHumans.outline.revealCurrent",
        "title": "%command.outline.revealCurrent.title%",
        "icon": "$(target)"
      },
      {
        "command": "markdownForHumans.outline.filter",
        "title": "%command.outline.filter.title%",
        "icon": "$(search)"
      },
      {
        "command": "markdownForHumans.outline.clearFilter",
        "title": "%command.outline.clearFilter.title%",
        "icon": "$(close)"
      },
      {
        "command": "markdownForHumans.toggleFormattingShortcuts",
        "title": "%command.toggleFormattingShortcuts.title%"
      },
      {
        "command": "markdownForHumans.copyReferenceForAi",
        "title": "%command.copyReferenceForAi.title%",
        "enablement": "activeCustomEditorId == 'markdownForHumans.editor'"
      },
      {
        "command": "markdownForHumans.pastePlainText",
        "title": "%command.pastePlainText.title%"
      },
      {
        "command": "markdownForHumans.feedback.start",
        "title": "%command.feedback.start.title%"
      },
      {
        "command": "markdownForHumans.feedback.commentSelection",
        "title": "%command.feedback.commentSelection.title%"
      },
      {
        "command": "markdownForHumans.feedback.chooseScope",
        "title": "%command.feedback.chooseScope.title%"
      },
      {
        "command": "markdownForHumans.feedback.captureArea",
        "title": "%command.feedback.captureArea.title%"
      },
      {
        "command": "markdownForHumans.feedback.captureSelectedBlocks",
        "title": "%command.feedback.captureSelectedBlocks.title%"
      },
      {
        "command": "markdownForHumans.feedback.toggleComments",
        "title": "%command.feedback.toggleComments.title%"
      },
      {
        "command": "markdownForHumans.feedback.next",
        "title": "%command.feedback.next.title%"
      },
      {
        "command": "markdownForHumans.feedback.previous",
        "title": "%command.feedback.previous.title%"
      },
      {
        "command": "markdownForHumans.feedback.finish",
        "title": "%command.feedback.finish.title%"
      },
      {
        "command": "markdownForHumans.feedback.reveal",
        "title": "%command.feedback.reveal.title%"
      },
      {
        "command": "markdownForHumans.feedback.discard",
        "title": "%command.feedback.discard.title%"
      }
    ],
    "keybindings": [
      {
        "command": "markdownForHumans.toggleFormattingShortcuts",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "activeCustomEditorId == 'markdownForHumans.editor'"
      },
      {
        "command": "markdownForHumans.pastePlainText",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeCustomEditorId == 'markdownForHumans.editor' && !terminalFocus && !inputFocus"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "markdownForHumansOutline",
          "name": "%view.outline.name%",
          "when": "markdownForHumans.isActive"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "markdownForHumans.copyReferenceForAi",
          "when": "activeCustomEditorId == 'markdownForHumans.editor'"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownForHumans.openFile",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownForHumans.openFile",
          "when": "resourceExtname == .md && activeCustomEditorId != 'markdownForHumans.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "markdownForHumans.outline.revealCurrent",
          "when": "view == markdownForHumansOutline",
          "group": "navigation@1"
        },
        {
          "command": "markdownForHumans.outline.filter",
          "when": "view == markdownForHumansOutline && !markdownForHumans.outlineFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "markdownForHumans.outline.clearFilter",
          "when": "view == markdownForHumansOutline && markdownForHumans.outlineFilterActive",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "markdownForHumans.imagePath": {
          "type": "string",
          "default": "images",
          "description": "%configuration.imagePath.description%"
        },
        "markdownForHumans.imagePathBase": {
          "type": "string",
          "enum": [
            "relativeToDocument",
            "workspaceFolder"
          ],
          "default": "relativeToDocument",
          "description": "%configuration.imagePathBase.description%"
        },
        "markdownForHumans.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.chromePath.markdownDescription%"
        },
        "markdownForHumans.imageResize.skipWarning": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.imageResize.skipWarning.description%"
        },
        "markdownForHumans.feedback.handoffPromptTemplate": {
          "type": "string",
          "default": "Implement the sealed feedback bundle at {{feedbackFile}}. First verify the source SHA-256. Inspect every referenced image. Edit the workspace files required by the feedback, but do not modify or delete the feedback bundle. Address every feedback ID, run appropriate checks, report the outcome per ID, and stop if the source hash differs.",
          "markdownDescription": "%configuration.feedback.handoffPromptTemplate.markdownDescription%",
          "scope": "resource",
          "editPresentation": "multilineText",
          "maxLength": 16384
        },
        "markdownForHumans.blankLines.mode": {
          "type": "string",
          "enum": [
            "preserve",
            "strip"
          ],
          "default": "strip",
          "description": "%configuration.blankLines.mode.description%"
        },
        "markdownForHumans.imagePreview.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.imagePreview.hover.enabled.description%",
          "scope": "application"
        },
        "markdownForHumans.paragraph.spacingBefore": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "%configuration.paragraph.spacingBefore.description%",
          "scope": "application"
        },
        "markdownForHumans.paragraph.spacingAfter": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "%configuration.paragraph.spacingAfter.description%",
          "scope": "application"
        },
        "markdownForHumans.zoom": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "%configuration.zoom.description%",
          "scope": "application"
        },
        "markdownForHumans.font.family": {
          "type": "string",
          "default": "",
          "maxLength": 1024,
          "markdownDescription": "%configuration.font.family.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.font.weight": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 900,
          "markdownDescription": "%configuration.font.weight.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.font.lineHeight": {
          "type": "number",
          "default": 1.58,
          "minimum": 1,
          "maximum": 3,
          "markdownDescription": "%configuration.font.lineHeight.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.font.letterSpacing": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 0.5,
          "markdownDescription": "%configuration.font.letterSpacing.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.font.wordSpacing": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "%configuration.font.wordSpacing.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.font.useEditorFont": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.font.useEditorFont.markdownDescription%",
          "scope": "application"
        },
        "markdownForHumans.enableMath": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableMath.description%"
        },
        "markdownForHumans.formattingShortcuts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.formattingShortcuts.enabled.description%",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "build:debug": "npm run build:extension:debug && npm run build:webview:debug",
    "build:release": "npm run build:extension:release && npm run build:webview:release && npm run verify-build",
    "verify-build": "node scripts/verify-build.js",
    "build:extension:debug": "node scripts/build-extension.js",
    "build:extension:release": "node scripts/build-extension.js --prod --no-sourcemap",
    "build:webview:debug": "node scripts/build-webview.js",
    "build:webview:release": "node scripts/build-webview.js --prod --no-sourcemap",
    "watch:debug": "concurrently \"npm run watch:extension:debug\" \"npm run watch:webview:debug\"",
    "watch:extension:debug": "node scripts/build-extension.js --watch",
    "watch:webview:debug": "node scripts/build-webview.js --watch",
    "lint": "eslint src --ext ts --max-warnings 0",
    "lint:fix": "eslint src --ext ts --fix",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "l10n:extract": "node scripts/l10n-extract.js",
    "test:integration": "npm run build:release && vscode-test",
    "test:feedback-capture": "node scripts/feedback-capture-fixture/run.mjs",
    "test:svg-browser": "node scripts/svg-image-fixture/run.mjs",
    "test:feedback-annotations": "node --test scripts/feedback-annotation-fixture/verification.test.mjs && node scripts/feedback-annotation-fixture/run.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "precommit": "npm run lint && npm run test",
    "validate": "npm run lint && npm run test && npm run build:debug",
    "package:release": "vsce package",
    "publish:release": "vsce publish --azure-credential",
    "publish:ovsx:release": "npm run build:release && ovsx publish",
    "install-hooks": "bash ./scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "20.17.58",
    "@types/vscode": "1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "babel-jest": "30.4.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/turndown": "^5.0.4",
    "cheerio": "^1.1.2",
    "docx": "^9.5.1",
    "highlight.js": "^11.11.1",
    "highlightjs-sap-abap": "^0.3.0",
    "katex": "^0.16.9",
    "lowlight": "^2.9.0",
    "markdown-it": "^14.0.0",
    "mermaid": "^11.17.2",
    "modern-screenshot": "4.7.0",
    "turndown": "^7.1.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "diff": "8.0.3",
        "serialize-javascript": "7.1.0"
      }
    }
  }
}
