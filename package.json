{
  "name": "markdown-for-humans",
  "displayName": "Markdown Editor for Humans",
  "description": "WYSIWYG Markdown editor and viewer with visual tables, Mermaid diagrams and image resizing. Saves plain Markdown.",
  "version": "0.4.3",
  "publisher": "concretio",
  "author": {
    "name": "Abhinav",
    "email": "abhinav@concret.io"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/concretios/markdown-for-humans"
  },
  "bugs": {
    "url": "https://github.com/concretios/markdown-for-humans/issues"
  },
  "homepage": "https://github.com/concretios/markdown-for-humans#readme",
  "engines": {
    "vscode": "^1.98.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Markdown Editor for Humans currently requires a disk-backed workspace for document-adjacent images, exports, and Feedback drafts."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Trust is required because the extension reads, writes, renders, and exports workspace content."
    }
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "md",
    "editor",
    "markdown-editor",
    "wysiwyg",
    "viewer",
    "markdown-viewer",
    "reader",
    "preview",
    "markdown-preview",
    "table",
    "table-editor",
    "mermaid",
    "diagram",
    "katex",
    "math",
    "typora",
    "obsidian",
    "notion",
    "notion-like",
    "rich-text",
    "gfm",
    "readme",
    "documentation",
    "writing",
    "pdf",
    "docx",
    "image",
    "image-resizing",
    "ai"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "markdownForHumans.codeKeyword",
        "description": "Keyword color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#a31545",
          "dark": "#c586c0",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeString",
        "description": "String and regular expression color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#a31515",
          "dark": "#ce9178",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeValue",
        "description": "Number, attribute, and variable color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#0451a5",
          "dark": "#b5cea8",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeFunction",
        "description": "Function and declaration color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#6f42c1",
          "dark": "#dcdcaa",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeType",
        "description": "Type, built-in, and tag name color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#00695c",
          "dark": "#4ec9b0",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeComment",
        "description": "Comment color in Markdown Editor for Humans code blocks.",
        "defaults": {
          "light": "#57606a",
          "dark": "#a3a3a3",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeAddition",
        "description": "Added-line color in Markdown Editor for Humans diff code blocks.",
        "defaults": {
          "light": "#116329",
          "dark": "#7ee787",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "markdownForHumans.codeDeletion",
        "description": "Deleted-line color in Markdown Editor for Humans diff code blocks.",
        "defaults": {
          "light": "#a40e26",
          "dark": "#ffa198",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "markdownForHumans.editor",
        "displayName": "Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.md",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.md",
            "scheme": "untitled"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "untitled"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownForHumans.openFile",
        "title": "Open with Markdown Editor for Humans"
      },
      {
        "command": "markdownForHumans.outline.revealCurrent",
        "title": "Outline: Reveal Current Heading",
        "icon": "$(target)"
      },
      {
        "command": "markdownForHumans.outline.filter",
        "title": "Outline: Filter Headings",
        "icon": "$(search)"
      },
      {
        "command": "markdownForHumans.outline.clearFilter",
        "title": "Outline: Clear Filter",
        "icon": "$(close)"
      },
      {
        "command": "markdownForHumans.toggleFormattingShortcuts",
        "title": "Markdown Editor for Humans: Toggle Formatting Shortcuts (Cmd/Ctrl+B/I/U)"
      },
      {
        "command": "markdownForHumans.feedback.start",
        "title": "Markdown Editor for Humans: Start Feedback"
      },
      {
        "command": "markdownForHumans.feedback.commentSelection",
        "title": "Markdown Editor for Humans: Add Feedback to Selection"
      },
      {
        "command": "markdownForHumans.feedback.chooseScope",
        "title": "Markdown Editor for Humans: Choose Feedback Scope"
      },
      {
        "command": "markdownForHumans.feedback.captureArea",
        "title": "Markdown Editor for Humans: Capture Feedback Area"
      },
      {
        "command": "markdownForHumans.feedback.captureSelectedBlocks",
        "title": "Markdown Editor for Humans: Capture Selected Blocks"
      },
      {
        "command": "markdownForHumans.feedback.toggleComments",
        "title": "Markdown Editor for Humans: Toggle Feedback Comments"
      },
      {
        "command": "markdownForHumans.feedback.next",
        "title": "Markdown Editor for Humans: Next Feedback"
      },
      {
        "command": "markdownForHumans.feedback.previous",
        "title": "Markdown Editor for Humans: Previous Feedback"
      },
      {
        "command": "markdownForHumans.feedback.finish",
        "title": "Markdown Editor for Humans: Finish Feedback and Copy Prompt"
      },
      {
        "command": "markdownForHumans.feedback.reveal",
        "title": "Markdown Editor for Humans: Reveal Feedback File"
      },
      {
        "command": "markdownForHumans.feedback.discard",
        "title": "Markdown Editor for Humans: Discard Feedback Draft"
      }
    ],
    "keybindings": [
      {
        "command": "markdownForHumans.toggleFormattingShortcuts",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "activeCustomEditorId == 'markdownForHumans.editor'"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "markdownForHumansOutline",
          "name": "Markdown Editor for Humans: Outline",
          "when": "markdownForHumans.isActive"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "markdownForHumans.openFile",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownForHumans.openFile",
          "when": "resourceExtname == .md && activeCustomEditorId != 'markdownForHumans.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "markdownForHumans.outline.revealCurrent",
          "when": "view == markdownForHumansOutline",
          "group": "navigation@1"
        },
        {
          "command": "markdownForHumans.outline.filter",
          "when": "view == markdownForHumansOutline && !markdownForHumans.outlineFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "markdownForHumans.outline.clearFilter",
          "when": "view == markdownForHumansOutline && markdownForHumans.outlineFilterActive",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Editor for Humans",
      "properties": {
        "markdownForHumans.imagePath": {
          "type": "string",
          "default": "images",
          "description": "Folder path for saved images. Interpreted relative to markdownForHumans.imagePathBase."
        },
        "markdownForHumans.imagePathBase": {
          "type": "string",
          "enum": [
            "relativeToDocument",
            "workspaceFolder"
          ],
          "default": "relativeToDocument",
          "description": "Controls whether Image Path is relative to the current markdown file folder or the workspace folder."
        },
        "markdownForHumans.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to Google Chrome or Chromium executable for PDF export. Leave empty to auto-detect.\n\n**Download Chrome:**\n- [Windows/Mac/Linux](https://www.google.com/chrome/)\n- [Chromium (open source)](https://www.chromium.org/getting-involved/download-chromium/)\n\n**Common paths:**\n- **Mac:** `/Applications/Google Chrome.app/Contents/MacOS/Google Chrome`\n- **Windows:** `C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe`\n- **Linux:** `/usr/bin/google-chrome` or `/usr/bin/chromium`"
        },
        "markdownForHumans.imageResize.skipWarning": {
          "type": "boolean",
          "default": false,
          "description": "Skip the warning dialog when resizing images. When enabled, images will be resized immediately without confirmation."
        },
        "markdownForHumans.feedback.handoffPromptTemplate": {
          "type": "string",
          "default": "Implement the sealed feedback bundle at {{feedbackFile}}. First verify the source SHA-256. Inspect every referenced image. Edit the workspace files required by the feedback, but do not modify or delete the feedback bundle. Address every feedback ID, run appropriate checks, report the outcome per ID, and stop if the source hash differs.",
          "markdownDescription": "Prompt copied after a feedback bundle is sealed. `{{feedbackFile}}` is required and expands as Markdown inline code. Optional placeholders are `{{source}}` (also Markdown inline code), `{{sourceSha256}}`, `{{itemCount}}`, and `{{round}}`. Invalid or oversized templates safely fall back to this built-in prompt.",
          "scope": "resource",
          "editPresentation": "multilineText",
          "maxLength": 16384
        },
        "markdownForHumans.blankLines.mode": {
          "type": "string",
          "enum": [
            "preserve",
            "strip"
          ],
          "default": "strip",
          "description": "Controls whether extra blank lines are preserved or removed in the editor and saved file."
        },
        "markdownForHumans.imagePreview.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the image hover overlay that shades images and displays metadata (resolution, file size, etc.) on hover.",
          "scope": "application"
        },
        "markdownForHumans.paragraph.spacingBefore": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "Space before paragraphs in points (margin-top). Default: 0pt",
          "scope": "application"
        },
        "markdownForHumans.paragraph.spacingAfter": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "Space after paragraphs in points (margin-bottom). Default: 0pt",
          "scope": "application"
        },
        "markdownForHumans.zoom": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "Zoom level for the editor as a percentage. 100 = default size, 150 = 50% larger, etc.",
          "scope": "application"
        },
        "markdownForHumans.enableMath": {
          "type": "boolean",
          "default": true,
          "description": "Render LaTeX math expressions using KaTeX. Use $...$ for inline math and $$...$$ for display math. Toggling this setting requires reopening the editor."
        },
        "markdownForHumans.formattingShortcuts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, Cmd/Ctrl+B, +I, and +U toggle bold/italic/underline inside the editor. Disable this if you rely on VS Code keybindings that use the same chords (e.g. a sidebar toggle rebound to Cmd+B) and want them to keep working while a markdown file is open in this editor.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "build:debug": "npm run build:extension:debug && npm run build:webview:debug",
    "build:release": "npm run build:extension:release && npm run build:webview:release && npm run verify-build",
    "verify-build": "node scripts/verify-build.js",
    "build:extension:debug": "node scripts/build-extension.js",
    "build:extension:release": "node scripts/build-extension.js --prod --no-sourcemap",
    "build:webview:debug": "node scripts/build-webview.js",
    "build:webview:release": "node scripts/build-webview.js --prod --no-sourcemap",
    "watch:debug": "concurrently \"npm run watch:extension:debug\" \"npm run watch:webview:debug\"",
    "watch:extension:debug": "node scripts/build-extension.js --watch",
    "watch:webview:debug": "node scripts/build-webview.js --watch",
    "lint": "eslint src --ext ts --max-warnings 0",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "jest",
    "test:integration": "npm run build:release && vscode-test",
    "test:feedback-capture": "node scripts/feedback-capture-fixture/run.mjs",
    "test:svg-browser": "node scripts/svg-image-fixture/run.mjs",
    "test:feedback-annotations": "node --test scripts/feedback-annotation-fixture/verification.test.mjs && node scripts/feedback-annotation-fixture/run.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "precommit": "npm run lint && npm run test",
    "validate": "npm run lint && npm run test && npm run build:debug",
    "package:release": "vsce package",
    "publish:release": "vsce publish",
    "publish:ovsx:release": "npm run build:release && ovsx publish",
    "install-hooks": "bash ./scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "20.17.58",
    "@types/vscode": "1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "babel-jest": "30.4.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/turndown": "^5.0.4",
    "cheerio": "^1.1.2",
    "docx": "^9.5.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.9",
    "lowlight": "^2.9.0",
    "markdown-it": "^14.0.0",
    "mermaid": "^11.17.2",
    "modern-screenshot": "4.7.0",
    "turndown": "^7.1.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "diff": "8.0.3",
        "serialize-javascript": "7.1.0"
      }
    }
  }
}
